
# Testbed Service Configuration
SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service Ports (Host Port Mapping)
GATEWAY_PORT=8000
ORDERS_PORT=8001
PAYMENTS_PORT=8002
INVENTORY_PORT=8003

# Downstream URLs (for local execution outside docker)
ORDERS_SERVICE_URL=http://localhost:8001
INVENTORY_SERVICE_URL=http://localhost:8003
PAYMENTS_SERVICE_URL=http://localhost:8002

# Database Configuration (Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=incidents
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cache Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Fault Simulation & Tuning Knobs
DB_POOL_SIZE=10
DB_TIMEOUT=5.0
PAYMENTS_TIMEOUT_MS=5000
PAYMENT_PROCESSING_DELAY_MS=20.0
SIMULATE_PAYMENT_FAILURE=false
MEMORY_LEAK_ENABLED=false
MEMORY_LEAK_CHUNK_KB=1024

# Toxiproxy (Fault Injection Proxy)
TOXIPROXY_API_PORT=8474
TOXIPROXY_URL=http://localhost:8474

# OpenTelemetry Collector
OTEL_GRPC_ENDPOINT=0.0.0.0:4317
OTEL_HTTP_ENDPOINT=0.0.0.0:4318

# Platform Ingestion & API (Phase 1)
INGEST_HOST=0.0.0.0
INGEST_PORT=8000
API_HOST=0.0.0.0
API_PORT=8080
